{
  "name": "-riic-tools",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "prettier": {
    "endOfLine": "auto"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test:schedule-import": "node scripts/schedule-import-regression.mjs",
    "test:schedule-list": "node scripts/schedule-list-regression.mjs",
    "test:simulator-layout": "node scripts/simulator-layout-regression.mjs",
    "test:simulator-result": "node scripts/simulator-result-regression.mjs",
    "test:simulator-clipboard": "node scripts/simulator-clipboard-regression.mjs",
    "test:operator-avatar": "node scripts/operator-avatar-regression.mjs",
    "test:operator-progression": "node scripts/operator-progression-regression.mjs",
    "test:efficiency": "node scripts/efficiency-regression.mjs",
    "test:sanity": "node scripts/sanity-regression.mjs",
    "generate:operator-skills": "node scripts/generate-operator-skills.mjs",
    "sync:prts": "node scripts/sync-prts-implementation-dates.mjs",
    "sync:torappu": "node scripts/sync-torappu.mjs",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "ant-design-vue": "^4.2.6",
    "html-to-image": "^1.11.13",
    "vue": "^3.5.40",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "npm-run-all2": "^9.0.2",
    "prettier": "^3.9.6",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vue-tsc": "^3.3.7"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
